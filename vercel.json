{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/claude.js": {
      "maxDuration": 55
    },
    "api/pool.js": {
      "maxDuration": 55
    },
    "api/bootstrap-pool.js": {
      "maxDuration": 55
    },
    "api/cron-refill-pool.js": {
      "maxDuration": 55
    }
  },
  "crons": [
    {
      "path": "/api/cron-refill-pool",
      "schedule": "0 7 * * *"
    }
  ]
}
